manifest {
    name            = 'larryivan/mstflow'
    description     = 'Fragment-aware metagenomic profiling for ancient and modern DNA, with optional source attribution'
    homePage        = 'https://github.com/larryivan/mstflow'
    license         = 'MIT'
    contributors    = [[name: 'Yufan Han', contribution: ['author', 'maintainer']]]
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '>=25.10.4'
    version         = '0.1.0'
}

plugins {
    id 'nf-schema@2.7.3'
}

validation {
    help {
        enabled = true
        command = 'nextflow run larryivan/mstflow -profile docker --input samplesheet.tsv --kraken2_db k2_db/ --host_fasta host.fa'
        afterText = 'Quick test: nextflow run larryivan/mstflow -profile test,docker\nDocs: https://github.com/larryivan/mstflow'
    }
    summary {
        hideParams = ['container_fastqc', 'container_fastp', 'container_adapterremoval', 'container_bwa', 'container_kraken2', 'container_multiqc', 'container_python_tools', 'container_sourcetracker2', 'container_krakenuniq', 'container_sourcepredict', 'container_attribution', 'container_bowtie2', 'container_pydamage']
    }
}

params {
    input              = null
    outdir             = 'results'

    remove_host        = true
    host_fasta         = null
    host_remove_max_forks = 4
    host_min_mapq      = 0
    default_host_group = 'human'
    require_explicit_host_for_nondefault = true
    require_explicit_host_action = false

    // Classifier: 'kraken2' or 'krakenuniq'.
    classifier         = 'kraken2'
    run_kraken2        = true
    kraken2_db         = null
    kraken2_extra_args = ''
    kraken2_max_forks  = 1
    kraken2_cpus       = 16
    kraken2_memory     = '160 GB'
    kraken2_time       = '36h'
    kraken2_kmer_len   = 35
    kraken2_min_read_len = 35
    kraken2_confidence = 0.05
    kraken2_minimum_hit_groups = 2
    kraken2_use_names = true
    kraken2_report_minimizer_data = true
    // Drop a taxon from a sample when its reads cover fewer distinct minimizers; 0 keeps all.
    kraken2_min_distinct_minimizers = 0
    kraken2_save_read_classifications = false

    krakenuniq_db      = null
    krakenuniq_preload_size = null   // e.g. '16G' to load the database in chunks; unset loads it whole
    // aMeta's default (Pochon et al. 2023): a taxon needs this many unique k-mers.
    krakenuniq_min_kmers = 1000

    // Count table: the reads classified to each taxon at this rank or below it.
    rank            = 'G'

    taxon_filter       = 'none'
    taxdump            = null
    drop_taxids        = '0,1'

    // Source attribution: which methods to run (comma-separated); empty runs none.
    attribution_methods = ''
    attribution_label   = 'default'
    attribution_aggregate_by = 'unit_id'
    attribution_taxon_scope  = 'filtered'
    attribution_min_classified_fraction = 0.001
    attribution_min_retained_reads      = 1000
    attribution_min_retained_fraction   = 0.001
    // A sink is assigned to its leading source only when all three hold.
    attribution_max_unknown   = 0.5
    attribution_min_top_known = 0.5
    attribution_min_margin    = 0.05
    attribution_seed = 1
    // Cross-validation: hold out the sources sharing a value of this column.
    attribution_cv       = false
    attribution_cv_group = 'project'

    sourcetracker2_source_rarefaction_depth = 1000
    sourcetracker2_sink_rarefaction_depth   = 1000
    sourcetracker2_alpha1 = 0.001
    sourcetracker2_alpha2 = 0.1
    sourcetracker2_beta   = 10
    sourcetracker2_restarts = 10
    sourcetracker2_draws_per_restart = 1
    sourcetracker2_burnin = 100
    sourcetracker2_delay  = 10

    feast_em_iterations = 1000
    feast_coverage      = 0       // 0: the smallest sink or pooled source

    // SourceID-NMF has no licence and is not redistributed: its code is fetched from
    // this location, the authors' repository at a fixed commit, or a local copy.
    sourceid_nmf_code       = 'https://raw.githubusercontent.com/ZiyiHuang0708/SourceID-NMF/4fd1cdff0b2781cdae8bf1f5c71aa6b72779578a'
    sourceid_nmf_iterations = 2000
    sourceid_nmf_rho        = 1
    sourceid_nmf_weight     = 1
    sourceid_nmf_tolerance  = 1e-6

    sourcepredict_neighbors     = 0      // 0: chosen by SourcePredict, or 5 for small panels
    sourcepredict_unknown_alpha = 0.1
    sourcepredict_normalization = 'SUBSAMPLE'
    sourcepredict_distance      = 'weighted_unifrac'
    sourcepredict_embedding     = 'auto'

    // Authentication: the reference genomes (Kraken-style headers with kraken:taxid|N),
    // with a Bowtie2 index beside them or built on the fly; unset skips the step.
    authentication_genomes   = null
    authentication_top_taxa  = 10
    authentication_min_reads = 100

    // Shortest read kept after trimming, the same for ancient and modern libraries so
    // that both enter the analysis on the same terms.
    min_length         = 35
    ancient_pe_mode    = 'collapsed_only'
    // Compression level (0-9) for FASTQ written by bin/mstflow_fragment_tools.py.
    // Affects only the compressed bytes, never decompressed content or counts.
    fastq_gzip_level   = 6
    fastp_extra_args   = ''
    adapterremoval_extra_args = ''

    multiqc_title      = 'mstflow'
    // Samples below either threshold are flagged in the sample summary.
    qc_min_classified_reads = 10000
    qc_min_taxa        = 20
    qc_min_taxon_reads = 10   // a taxon counts towards qc_min_taxa with this many reads
    publish_intermediates = false

    // Immutable linux/amd64 runtime identities for the pinned scientific
    // toolchain. Sites may override these logical parameters with verified,
    // pre-staged SIF paths without changing workflow code.
    container_fastqc = 'quay.io/biocontainers/fastqc@sha256:e194048df39c3145d9b4e0a14f4da20b59d59250465b6f2a9cb698445fd45900'
    container_fastp = 'quay.io/biocontainers/fastp@sha256:fe647f76dbda3af58a4e159ec4662b7c11f29ee65a44a9b8f43ba018fee8e8a5'
    container_adapterremoval = 'quay.io/biocontainers/adapterremoval@sha256:238d0a5366f2e000bf92e48b924a8f22a66863d916abe657c32c31e8449ee9a6'
    container_bwa = 'quay.io/biocontainers/bwa@sha256:99a35e5ee4e9c329e8746c4689890b97a3ac5620cb36d374cba69ba52016e72a'
    container_kraken2 = 'quay.io/biocontainers/kraken2@sha256:e34b3c44d75897c6ef640fbccbc49427a1ad60ec0e51388c255055c8f0ad1c66'
    container_multiqc = 'quay.io/biocontainers/multiqc@sha256:f4ebfe78e45dd96f04a9c883e1882e77ac357988a10a7c980df6d500bfc46de6'
    container_python_tools = 'community.wave.seqera.io/library/mstflow-python@sha256:d2b92483fb86612072c2de3f044f9c7ca779862e59f93aef06016cb95748b6bc'
    container_sourcetracker2 = 'community.wave.seqera.io/library/mstflow-sourcetracker2@sha256:046134dc1b699151b56555df8f729316e3b8e23101934c046287afe2403b552e'
    container_krakenuniq = 'quay.io/biocontainers/krakenuniq@sha256:e5da88e0f37f7d2a28eaf5b1904dcb02a8d47886384419379e7c4ef981f46e30'
    container_sourcepredict = 'quay.io/biocontainers/sourcepredict@sha256:ae40bd6bbb6272099bfb9192d97bcdceccc9d6bdcf321299a3ea236a359217ca'
    container_bowtie2 = 'community.wave.seqera.io/library/bowtie2_htslib_samtools_pigz@sha256:13cf4544b7e368aedd050c3bde71861444597806bf574226752e0a260433e108'
    container_pydamage = 'quay.io/biocontainers/pydamage@sha256:eaa2f0e7cb7548a55137541c611248571dbf26bcc3369915919c02157f450fe5'
    // Built from containers/attribution/Dockerfile.
    container_attribution = 'ghcr.io/larryivan/mstflow-attribution@sha256:a8e2c0b1e8d8ea9947b121d432fcf156468ea3239f3bc5dd271f52509ddccb8a'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    // A task killed for memory or time (exit 130-145, 104, 175) is retried once
    // with twice the memory and time. Any other failure stops the run cleanly,
    // letting running tasks finish first.
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_low {
        cpus = 2
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }

    withLabel: process_medium {
        cpus = 4
        memory = { 16.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withLabel: process_high {
        cpus = 8
        memory = { 32.GB * task.attempt }
        time = { 36.h * task.attempt }
    }

    // Kraken2 holds the whole database in memory, so its size sets the
    // requirement. Set kraken2_memory to the database size plus some headroom.
    withName: 'KRAKEN2_PROFILE|KRAKENUNIQ_PROFILE' {
        cpus = params.kraken2_cpus as int
        memory = { MemoryUnit.of(params.kraken2_memory.toString()) * task.attempt }
        time = { Duration.of(params.kraken2_time.toString()) * task.attempt }
        maxForks = params.kraken2_max_forks as int
    }

    withName: HOST_ALIGN_BWA {
        maxForks = params.host_remove_max_forks as int
    }

    withName: 'SOURCEPREDICT|PREPARE_SOURCEPREDICT_TAXONOMY' {
        conda = "${projectDir}/envs/sourcepredict.yml"
    }

    withName: KRAKENUNIQ_PROFILE {
        conda = "${projectDir}/envs/krakenuniq.yml"
    }

    withName: 'BOWTIE2_BUILD|BOWTIE2_ALIGN|AUTHENTICATE' {
        conda = "${projectDir}/envs/authentication.yml"
    }

    withName: SOURCEID_NMF {
        conda = "${projectDir}/envs/sourceid_nmf.yml"
    }

    withName: SOURCETRACKER2 {
        // SourceTracker2 2.0.1 uses NumPy's process-global RNG. One seeded
        // process is required for reproducible Gibbs sampling.
        cpus = 1
        conda = "${projectDir}/envs/sourcetracker2.yml"
    }
}

conda {
    createOptions = '--strict-channel-priority'
    createTimeout = '2h'
}

profiles {
    conda {
        conda.enabled = true
        conda.useMamba = true
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = false
        process.conda = "${projectDir}/envs/mstflow.yml"
    }

    docker {
        conda.enabled = false
        docker.enabled = true
        // Every pinned image is linux/amd64; this also lets ARM machines run them.
        docker.runOptions = '-u $(id -u):$(id -g) --platform linux/amd64'
        apptainer.enabled = false
        singularity.enabled = false
    }

    apptainer {
        conda.enabled = false
        docker.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        singularity.enabled = false
    }

    singularity {
        conda.enabled = false
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
    }

    // End-to-end run on real public data, downloaded on first use (see conf/test.config).
    test {
        includeConfig 'conf/test.config'
    }

}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}
