manifest {
    name            = 'larryivan/mstflow'
    description     = 'Fragment-aware metagenomic profiling for ancient and modern DNA, with optional source attribution'
    homePage        = 'https://github.com/larryivan/mstflow'
    license         = 'MIT'
    contributors    = [[name: 'Yufan Han', contribution: ['author', 'maintainer']]]
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '>=25.10.4'
    version         = '0.1.0'
}

params {
    input              = null
    outdir             = 'results'

    remove_host        = true
    host_fasta         = null
    host_remove_max_forks = 4
    host_min_mapq      = 0
    default_host_group = 'human'
    require_explicit_host_for_nondefault = true
    require_explicit_host_action = false

    run_kraken2        = true
    kraken2_db         = null
    kraken2_extra_args = ''
    kraken2_max_forks  = 1
    kraken2_cpus       = 16
    kraken2_memory     = '160 GB'
    kraken2_time       = '36h'
    kraken2_kmer_len   = 35
    kraken2_min_read_len = 35
    kraken2_confidence = 0.05
    kraken2_minimum_hit_groups = 2
    kraken2_use_names = true
    kraken2_report_minimizer_data = true
    kraken2_save_read_classifications = false

    run_bracken        = true
    bracken_db         = null    // defaults to kraken2_db
    bracken_rank       = 'G'
    bracken_read_len   = 'auto'
    bracken_threshold  = 10
    bracken_extra_args = ''

    taxon_filter       = 'none'
    taxdump            = null
    drop_taxids        = '0,1'

    run_sourcetracker2 = false
    sourcetracker2_source_rarefaction_depth = 1000
    sourcetracker2_sink_rarefaction_depth   = 1000
    sourcetracker2_extra_args = ''
    sourcetracker2_aggregate_by = 'unit_id'
    sourcetracker2_taxon_scope = 'filtered'
    sourcetracker2_analysis_label = 'default'
    sourcetracker2_include_panel_roles = ''
    sourcetracker2_exclude_panel_roles = 'control,holdout'
    sourcetracker2_exclude_source_envs = ''
    sourcetracker2_exclude_source_classes = ''
    sourcetracker2_min_kraken_classified_fraction = 0.001
    sourcetracker2_min_taxon_filter_retained_reads = 1000
    sourcetracker2_min_taxon_filter_retained_fraction = 0.001
    sourcetracker2_max_unknown_prop = 0.5
    sourcetracker2_min_top_known_prop = 0.5
    sourcetracker2_min_top_known_margin = 0.05
    sourcetracker2_loo = false
    sourcetracker2_seed = 1

    min_length_modern  = 50
    min_length_ancient = 35
    ancient_pe_mode    = 'collapsed_only'
    // Retained for backward compatibility. The workflow no longer concatenates
    // mates, so this only affects the deprecated `combine` helper subcommand.
    fragment_pair_gap  = 100
    // Compression level (0-9) for FASTQ written by bin/mstflow_fragment_tools.py.
    // Affects only the compressed bytes, never decompressed content or counts.
    fastq_gzip_level   = 6
    fastp_extra_args   = ''
    adapterremoval_extra_args = ''

    multiqc_title      = 'mstflow'
    publish_intermediates = false

    // Immutable linux/amd64 runtime identities for the pinned scientific
    // toolchain. Sites may override these logical parameters with verified,
    // pre-staged SIF paths without changing workflow code.
    container_fastqc = 'quay.io/biocontainers/fastqc@sha256:e194048df39c3145d9b4e0a14f4da20b59d59250465b6f2a9cb698445fd45900'
    container_fastp = 'quay.io/biocontainers/fastp@sha256:fe647f76dbda3af58a4e159ec4662b7c11f29ee65a44a9b8f43ba018fee8e8a5'
    container_adapterremoval = 'quay.io/biocontainers/adapterremoval@sha256:238d0a5366f2e000bf92e48b924a8f22a66863d916abe657c32c31e8449ee9a6'
    container_bwa = 'quay.io/biocontainers/bwa@sha256:99a35e5ee4e9c329e8746c4689890b97a3ac5620cb36d374cba69ba52016e72a'
    container_kraken2 = 'quay.io/biocontainers/kraken2@sha256:e34b3c44d75897c6ef640fbccbc49427a1ad60ec0e51388c255055c8f0ad1c66'
    container_bracken = 'quay.io/biocontainers/bracken@sha256:e5b82891e0b6d83d9df5facfe7ff608824ef5836de0d416a1d6df8ec4b9f124b'
    container_biom = 'quay.io/biocontainers/biom-format@sha256:25cd60ce74239ad322e9d7c01fedbae03c4f8bc8bf030c1c72e954feff38963c'
    container_multiqc = 'quay.io/biocontainers/multiqc@sha256:f4ebfe78e45dd96f04a9c883e1882e77ac357988a10a7c980df6d500bfc46de6'
    container_python_tools = 'community.wave.seqera.io/library/mstflow-python@sha256:d2b92483fb86612072c2de3f044f9c7ca779862e59f93aef06016cb95748b6bc'
    container_sourcetracker2 = 'community.wave.seqera.io/library/mstflow-sourcetracker2@sha256:046134dc1b699151b56555df8f729316e3b8e23101934c046287afe2403b552e'

}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: process_low {
        cpus = 2
        memory = '4 GB'
        time = '4h'
    }

    withLabel: process_medium {
        cpus = 4
        memory = '16 GB'
        time = '12h'
    }

    withLabel: process_high {
        cpus = 8
        memory = '32 GB'
        time = '36h'
    }

    // Kraken database memory varies widely. These conservative defaults are
    // explicit and can be overridden for the selected database.
    withName: KRAKEN2_PROFILE {
        cpus = params.kraken2_cpus as int
        memory = params.kraken2_memory
        time = params.kraken2_time
        maxForks = params.kraken2_max_forks as int
    }

    withName: HOST_ALIGN_BWA {
        maxForks = params.host_remove_max_forks as int
    }

    // SourceTracker2 2.0.1 needs the pinned Python 3.8 compatibility stack;
    // it must never inherit the Python 3.10 main tool environment.
    withName: SOURCETRACKER2_GIBBS {
        // SourceTracker2 2.0.1 uses NumPy's process-global RNG. One seeded
        // process is required for reproducible Gibbs sampling.
        cpus = 1
        conda = "${projectDir}/envs/sourcetracker2.yml"
    }
}

conda {
    createOptions = '--strict-channel-priority'
    createTimeout = '2h'
}

profiles {
    standard {
        process.executor = 'local'
        conda.enabled = false
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = false
    }

    conda {
        process.executor = 'local'
        conda.enabled = true
        conda.useMamba = true
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = false
        process.conda = "${projectDir}/envs/mstflow.yml"
    }

    docker {
        process.executor = 'local'
        conda.enabled = false
        docker.enabled = true
        apptainer.enabled = false
        singularity.enabled = false
    }

    apptainer {
        process.executor = 'local'
        conda.enabled = false
        docker.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        singularity.enabled = false
    }

    singularity {
        process.executor = 'local'
        conda.enabled = false
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
    }

    // Stub-only resource profile. It is deliberately small and must never be
    // used for real BWA/Kraken work.
    test {
        process {
            executor = 'local'
            withLabel: process_low {
                cpus = 1
                memory = '1 GB'
                time = '30m'
            }
            withLabel: process_medium {
                cpus = 1
                memory = '1 GB'
                time = '30m'
            }
            withLabel: process_high {
                cpus = 1
                memory = '1 GB'
                time = '30m'
            }
            withName: KRAKEN2_PROFILE {
                cpus = 1
                memory = '1 GB'
                time = '30m'
                maxForks = 1
            }
        }
    }

}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}
