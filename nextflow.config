manifest {
    name            = 'mstflow'
    description     = 'Metagenomic preprocessing, host removal, Kraken2/Bracken profiling, and SourceTracker2 attribution'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.0'
}

params {
    input              = 'examples/metadata.example.tsv'
    outdir             = 'results'

    remove_host        = true
    host_fasta         = null

    run_kraken2        = true
    kraken2_db         = null
    kraken2_extra_args = ''

    run_bracken        = false
    bracken_db         = null
    bracken_rank       = 'G'
    bracken_read_len   = 100
    bracken_threshold  = 10
    bracken_extra_args = ''

    taxon_filter       = 'none'
    taxdump            = null
    drop_taxids        = '0,1'

    run_sourcetracker2 = false
    sourcetracker2_source_rarefaction_depth = 1000
    sourcetracker2_sink_rarefaction_depth   = 1000
    sourcetracker2_extra_args = ''

    min_length_modern  = 50
    min_length_ancient = 30
    fastp_extra_args   = ''
    adapterremoval_extra_args = ''

    multiqc_title      = 'mstflow'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: process_low {
        cpus = 2
        memory = '2 GB'
    }

    withLabel: process_medium {
        cpus = 4
        memory = '4 GB'
    }

    withLabel: process_high {
        cpus = 8
        memory = '8 GB'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        process.executor = 'local'
        conda.enabled = true
        conda.useMamba = true
        process.conda = "${projectDir}/envs/mstflow.yml"
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}
