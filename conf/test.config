/*
 * End-to-end test on real public data: the first 50,000 reads of 15 published
 * libraries (oral, gut, soil and laboratory-blank sources, modern and ancient, and four
 * ancient sinks) and a Kraken2/Bracken database of the 274 genomes that cover them.
 * The files, about 1.8 GB, are downloaded from the test-data-v1 release on the first
 * run; assets/test describes where they come from and how they were built.
 *
 *   nextflow run larryivan/mstflow -profile test,docker
 *
 * Every source attribution method runs, and each is scored by holding out one study's
 * sources at a time.
 */
params {
    input        = 'https://github.com/larryivan/mstflow/releases/download/test-data-v1/samplesheet.tsv'
    kraken2_db   = 'https://github.com/larryivan/mstflow/releases/download/test-data-v1/kraken2_db.tar.gz'
    host_fasta   = 'https://github.com/larryivan/mstflow/releases/download/test-data-v1/host.fa'
    taxdump      = 'https://github.com/larryivan/mstflow/releases/download/test-data-v1/nodes.dmp'
    taxon_filter = 'prokaryote'

    kraken2_cpus   = 2
    kraken2_memory = '4 GB'
    kraken2_time   = '1h'
    multiqc_title  = 'MSTFlow test run'

    // Each library is only 50,000 reads and the database holds 274 genomes, so the
    // depth flags are scaled down to match.
    qc_min_classified_reads = 1000
    qc_min_taxa             = 10

    attribution_methods = 'sourcetracker2,feast,fastst,sourceid_nmf,sourcepredict'
    attribution_cv      = true
    attribution_cv_group = 'project'
    // With a 274-genome database each sink holds only a few dozen genera, and
    // SourceTracker2's default prior lets its unknown source absorb even sinks that
    // clearly match a source; see docs/attribution.md.
    sourcetracker2_alpha2   = 0.1
    sourceid_nmf_iterations = 500
}

process {
    resourceLimits = [cpus: 2, memory: '6 GB', time: '1h']
    withLabel: 'process_low|process_medium|process_high' {
        cpus   = 1
        memory = '2 GB'
        time   = '1h'
    }
}
