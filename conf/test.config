/*
 * Minimal end-to-end test. Every tool runs for real on the bundled synthetic data
 * in assets/test, so a run finishes in a few minutes on a laptop:
 *
 *   nextflow run larryivan/mstflow -profile test,docker
 */
params {
    input        = "${projectDir}/assets/test/samplesheet.tsv"
    host_fasta   = "${projectDir}/assets/test/host/host.fa"
    kraken2_db   = "${projectDir}/assets/test/kraken2_db"
    taxon_filter = 'prokaryote'
    taxdump      = "${projectDir}/assets/test/taxonomy"

    kraken2_cpus   = 2
    kraken2_memory = '2 GB'
    kraken2_time   = '1h'
    multiqc_title  = 'MSTFlow test run'

    // The test libraries are tiny, so the depth flags are scaled down to match.
    qc_min_classified_reads = 1000
    qc_min_taxa             = 3
}

process {
    resourceLimits = [cpus: 2, memory: '6 GB', time: '1h']
    withLabel: 'process_low|process_medium|process_high' {
        cpus   = 1
        memory = '2 GB'
        time   = '1h'
    }
}
